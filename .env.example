# Vercel 프로젝트 설정 > Environment Variables에 등록
# 카카오디벨로퍼스 앱의 REST API 키. 장소 검색과 대중교통 경로 조회에 사용
KAKAO_REST_API_KEY=

# 공공데이터포털 TAGO 버스도착정보 + 버스정류소정보 활용신청 후 받은 키
TAGO_BUS_API_KEY=

# 도착정보 조회용 기본 도시코드. TAGO 도시코드 목록에서 확인
TAGO_CITY_CODE=

# 선택 사항: 위치를 쓰지 않을 때 기본으로 조회할 실제 정류소 ID
TAGO_NODE_ID=

# 선택: 서버에서 음성 텍스트를 AI로 해석 (오디오/GPS 좌표는 보내지 않음)
# true로 켜고 키를 등록해야 외부 모델을 호출합니다. 사용량 과금이 발생할 수 있습니다.
VOICE_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_VOICE_INTENT_MODEL=gpt-4.1-mini
