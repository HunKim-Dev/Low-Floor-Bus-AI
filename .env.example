# Vercel 프로젝트 설정 > Environment Variables에 등록
# 카카오디벨로퍼스 앱의 REST API 키. 장소 검색과 대중교통 경로 조회에 사용
KAKAO_REST_API_KEY=

# 공공데이터포털 TAGO 버스도착정보 + 버스정류소정보 + 버스노선정보 활용신청 후 받은 공통 키
TAGO_BUS_API_KEY=

# 선택: 수동 정류소 조회의 기본 도시코드. 경로 검색에서는 노선 검증 결과를 자동 사용
TAGO_CITY_CODE=

# 선택 사항: 위치를 쓰지 않을 때 기본으로 조회할 실제 정류소 ID
TAGO_NODE_ID=

# 선택: Cloudflare Workers AI (서버 전용, NEXT_PUBLIC_ 접두사 금지)
# Account ID: 대시보드의 32자리 16진수 계정 ID (예시값을 채우지 마세요)
# API Token: 해당 계정 Workers AI 실행 권한이 있는 토큰
# 값이 비어 있으면 외부 AI를 호출하지 않고 기존 기기 음성인식/기본 해석을 사용
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VOICE_INTENT_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# 키 등록 후 활성화. 음성 녹음은 Cloudflare Whisper로, 텍스트는 Qwen으로 전송
# GPS 좌표/사용자 프로필은 LLM에 보내지 않음. 무료 할당량 초과 시 비용/제한 확인
VOICE_AI_ENABLED=true
VOICE_TRANSCRIPTION_ENABLED=true

# 선택: Google AI Studio에서 발급한 서버 전용 Gemini 키 (NEXT_PUBLIC_ 금지)
# 안내 문장만 Google에 전송. 무료 등급 데이터 처리 정책과 실제 할당량 확인 필요
GEMINI_API_KEY=
# 읽어주는 음성은 Gemini 2.5 Flash Preview TTS만 사용. false면 TTS 중지 (화면 안내 유지)
VOICE_TTS_ENABLED=true
# 선택: Sulafat(기본), Achernar, Kore. 기존 Cloudflare TTS 언어 설정은 사용하지 않음
GEMINI_TTS_VOICE=Sulafat
